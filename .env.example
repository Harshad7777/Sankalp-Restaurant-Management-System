# =====================================================
# Sankalp RMS - Environment Variables Example
# Copy to .env (never commit .env to GitHub)
# =====================================================

SPRING_PROFILES_ACTIVE=prod
PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Cloud SQL MySQL Connection
DB_URL=jdbc:mysql:///smprowor_RMS?cloudSqlInstance=PROJECT_ID:REGION:INSTANCE_NAME&socketFactory=com.google.cloud.sql.mysql.SocketFactory&useSSL=false&serverTimezone=UTC
DB_USERNAME=smprowor_harshad
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# Security Secrets (Use Google Cloud Secret Manager in Cloud Run)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_JWT_SECRET
JASYPT_ENCRYPTOR_PASSWORD=CHANGE_ME_JASYPT_PASSWORD

# Google Cloud Storage (Persistent Media)
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=sankalp-rms-media-PROJECT_ID
GCS_PREFIX=uploads/

# CORS & Frontend URL
APP_FRONTEND_URL=https://rms-frontend-xxxxx.run.app
CORS_ALLOWED_ORIGINS=https://rms-frontend-xxxxx.run.app

# Mail (Optional)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Swagger & Logging
SWAGGER_ENABLED=false
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_JDBC=WARN

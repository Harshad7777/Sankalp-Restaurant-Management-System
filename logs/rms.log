2026-08-16 14:13:45 DEBUG o.s.jdbc.core.JdbcTemplate - Executing SQL query [SELECT
    m.item_id,
    m.item_name,
    m.image,

    COUNT(DISTINCT od.order_id) AS total_orders,

    COALESCE(SUM(od.quantity), 0) AS sold_quantity

FROM order_details od

INNER JOIN menu m
    ON od.item_id = m.item_id

INNER JOIN orders o
    ON od.order_id = o.order_id

WHERE o.order_status <> 'CANCELLED'

GROUP BY
    m.item_id,
    m.item_name,
    m.image

ORDER BY
    total_orders DESC,
    sold_quantity DESC

LIMIT 5
]

2026-08-16 11:20:10 DEBUG o.s.jdbc.core.JdbcTemplate - Executing SQL query [SELECT
    o.order_id AS orderId,
    o.customer_id AS customerId,

    COALESCE(
        c.customer_name,
        'Walk-in Customer'
    ) AS customerName,

    o.table_id AS tableId,

    o.order_date AS orderDate,

    COALESCE(
        o.order_status,
        'NEW'
    ) AS orderStatus,

    COALESCE(
        o.remarks,
        ''
    ) AS remarks,

    COALESCE(
        o.total_amount,
        0
    ) AS totalAmount,

    od.order_detail_id AS detailId,

    od.item_id AS itemId,

    COALESCE(
        m.item_name,
        'Unknown Item'
    ) AS itemName,

    COALESCE(
        od.quantity,
        1
    ) AS quantity,

    COALESCE(
        od.price,
        0
    ) AS price,

    COALESCE(
        od.subtotal,
        0
    ) AS subtotal,

    COALESCE(
        od.kitchen_status,
        'NEW'
    ) AS kitchenStatus,

    od.is_extra AS isExtra,

    od.kitchen_note AS kitchenNote,

    od.prepared_by AS preparedBy,

    od.served_at AS servedAt,

    od.created_at AS createdAt

FROM orders o

LEFT JOIN customer c
    ON c.customer_id = o.customer_id

INNER JOIN order_details od
    ON od.order_id = o.order_id

LEFT JOIN menu m
    ON m.item_id = od.item_id

WHERE
    COALESCE(
        od.kitchen_status,
        'NEW'
    ) IN (
        'NEW',
        'ACCEPTED',
        'PREPARING',
        'READY',
        'SERVED'
    )

    AND COALESCE(
        o.order_status,
        'NEW'
    ) NOT IN (
        'CANCELLED',
        'PAID',
        'CLOSED',
        'BILLED'
    )

ORDER BY
    o.order_date DESC,
    od.order_detail_id ASC
]

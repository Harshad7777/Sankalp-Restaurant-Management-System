    ON od.item_id = m.item_id

INNER JOIN orders o
    ON od.order_id = o.order_id

WHERE o.order_status <> 'CANCELLED'

GROUP BY
    m.item_id,
    m.item_name,
    m.image

ORDER BY
    total_orders DESC,
    sold_quantity DESC

LIMIT 5
]
